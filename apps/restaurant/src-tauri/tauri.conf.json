{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterChef Restaurant",
  "version": "0.1.0",
  "identifier": "ug.masterchef.restaurant",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1421", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "MasterChef Restaurant", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 680, "resizable": true }], "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' http://localhost:1421; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all", "category": "Business", "shortDescription": "MasterChef restaurant operations application" }
}
